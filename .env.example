# Waitlist storage.
# When DATABASE_URL is set, signups are written to Postgres (table auto-created
# on first write). When it is unset, the app falls back to a local JSONL file
# at .data/waitlist.jsonl — development only, never for production.
DATABASE_URL=

# Set when the Postgres provider requires TLS but presents a self-signed chain
# (Supabase, Neon, Heroku, RDS). Accepts "true" / "false".
DATABASE_SSL=true

# Optional: POST every new signup to this URL (Slack incoming webhook, Zapier,
# an internal notifier). Failures are logged and never block the signup.
WAITLIST_WEBHOOK_URL=

# Canonical origin, used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://shiftstory.app

# Address shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=hello@shiftstory.app
