# Copy to .env.local and fill in. All values are optional in development —
# without storage configured the app writes to .data/waitlist.jsonl.

# ---------------------------------------------------------------------------
# Supabase (primary storage)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# SECRET. Waitlist writes use this key so they bypass Row-Level Security.
# Never prefix it with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Browser-visible copies for utils/supabase/client.ts. Public by design.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# Direct Postgres (alternative to Supabase; ignored when SUPABASE_URL is set)
# ---------------------------------------------------------------------------
DATABASE_URL=

# Set false for a local Postgres, true for a hosted provider with a
# self-signed chain.
DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# POST every new signup here (Slack incoming webhook, Zapier, an internal
# notifier). Failures are logged and never block the signup.
WAITLIST_WEBHOOK_URL=

# Canonical origin, used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://shiftstory.app

# Address shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=hello@shiftstory.app
